# Копия для .env — не коммитить настоящий .env.

# Токен от @BotFather для @JurnieksBot
BOT_TOKEN=1234567890:AAAA_placeholder_get_from_botfather

# Строка подключения. Локально:
#   sqlite+aiosqlite:///./bot.db
# На Railway: подтянется из плагина Postgres автоматически (или задать вручную)
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Твой Telegram chat_id (узнать: /start бота, ID в логах или через @userinfobot)
ADMIN_CHAT_ID=0

# INFO / DEBUG / WARNING
LOG_LEVEL=INFO
